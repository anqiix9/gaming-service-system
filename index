<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>陪玩接单系统</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, "Microsoft YaHei", sans-serif;
    background: #f6f4f8;
    color: #333;
}

.container {
    width: 94%;
    max-width: 1100px;
    margin: 25px auto;
}

/* 顶部 */
.header {
    background: white;
    padding: 25px;
    border-radius: 20px;
    margin-bottom: 20px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.header h1 {
    font-size: 28px;
    margin-bottom: 7px;
}

.header p {
    color: #888;
    font-size: 14px;
}

/* 统计 */
.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.stat-card {
    background: white;
    padding: 20px;
    border-radius: 17px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.stat-card p {
    color: #888;
    font-size: 14px;
    margin-bottom: 8px;
}

.stat-card h2 {
    font-size: 24px;
}

/* 区块 */
.section {
    background: white;
    padding: 25px;
    border-radius: 20px;
    margin-bottom: 20px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.section h2 {
    font-size: 20px;
    margin-bottom: 20px;
}

/* 表单 */
.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.form-group {
    margin-bottom: 15px;
}

.form-group.full {
    grid-column: 1 / -1;
}

label {
    display: block;
    font-size: 14px;
    color: #555;
    margin-bottom: 7px;
}

input,
select,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-size: 14px;
    outline: none;
    background: white;
}

textarea {
    min-height: 90px;
    resize: vertical;
}

input:focus,
select:focus,
textarea:focus {
    border-color: #888;
}

/* 按钮 */
.btn {
    border: none;
    border-radius: 10px;
    padding: 12px 18px;
    cursor: pointer;
    font-size: 14px;
}

.btn-main {
    width: 100%;
    background: #333;
    color: white;
}

.btn-edit {
    background: #f1f1f1;
    color: #333;
    margin-right: 6px;
}

.btn-delete {
    background: #ffe9e9;
    color: #d33;
}

.btn-cancel {
    background: #eee;
    margin-top: 10px;
    width: 100%;
    display: none;
}

/* 搜索 */
.search-area {
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: 10px;
    margin-bottom: 20px;
}

/* 订单 */
.order {
    border: 1px solid #eee;
    border-radius: 15px;
    padding: 17px;
    margin-bottom: 12px;
}

.order-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.order-name {
    font-weight: bold;
    font-size: 17px;
}

.order-money {
    font-weight: bold;
    font-size: 17px;
}

.order-info {
    color: #777;
    font-size: 14px;
    line-height: 1.8;
}

.order-buttons {
    margin-top: 12px;
}

.status {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 8px;
    font-size: 12px;
    margin-top: 7px;
}

.paid {
    background: #e7f7eb;
    color: #2e8b57;
}

.unpaid {
    background: #fff1e5;
    color: #d2691e;
}

.type {
    display: inline-block;
    background: #f0eef5;
    padding: 4px 9px;
    border-radius: 8px;
    font-size: 12px;
    margin-left: 5px;
}

.empty {
    text-align: center;
    color: #999;
    padding: 30px 10px;
}

/* 手机 */
@media (max-width: 700px) {

    .container {
        width: 94%;
        margin: 15px auto;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .search-area {
        grid-template-columns: 1fr;
    }

    .header h1 {
        font-size: 23px;
    }

    .section {
        padding: 20px;
    }
}

@media (max-width: 420px) {

    .stats {
        grid-template-columns: 1fr;
    }

}
</style>
</head>

<body>

<div class="container">

    <!-- 顶部 -->
    <div class="header">
        <h1>🎮 陪玩接单系统</h1>
        <p>记录每一张单子，管理你的工资</p>
    </div>


    <!-- 数据统计 -->
    <div class="stats">

        <div class="stat-card">
            <p>📋 今日单数</p>
            <h2 id="todayOrders">0</h2>
        </div>

        <div class="stat-card">
            <p>💰 今日工资</p>
            <h2>RM <span id="todayMoney">0.00</span></h2>
        </div>

        <div class="stat-card">
            <p>📅 本月单数</p>
            <h2 id="monthOrders">0</h2>
        </div>

        <div class="stat-card">
            <p>💵 本月工资</p>
            <h2>RM <span id="monthMoney">0.00</span></h2>
        </div>

    </div>


    <!-- 新增订单 -->
    <div class="section">

        <h2 id="formTitle">➕ 新增单子</h2>

        <div class="form-grid">

            <div class="form-group">
                <label>📅 日期</label>
                <input type="date" id="orderDate">
            </div>

            <div class="form-group">
                <label>👤 客户</label>
                <input
                    type="text"
                    id="customer"
                    placeholder="输入客户名字"
                >
            </div>

            <div class="form-group">
                <label>🎮 单子类型</label>

                <select id="orderType">
                    <option value="陪玩">陪玩</option>
                    <option value="代打">代打</option>
                    <option value="其他">其他</option>
                </select>

            </div>

            <div class="form-group">
                <label>💰 工资（RM）</label>

                <input
                    type="number"
                    id="salary"
                    placeholder="例如 30"
                    min="0"
                    step="0.01"
                >

            </div>

            <div class="form-group full">

                <label>📝 单子详情</label>

                <textarea
                    id="orderDetail"
                    placeholder="例如：ML 2小时 / 王者3局 / 陪玩语音..."
                ></textarea>

            </div>

            <div class="form-group">

                <label>💳 状态</label>

                <select id="status">
                    <option value="已结">已结</option>
                    <option value="未结">未结</option>
                </select>

            </div>

        </div>

        <button
            class="btn btn-main"
            onclick="saveOrder()"
            id="saveButton"
        >
            添加单子
        </button>

        <button
            class="btn btn-cancel"
            onclick="cancelEdit()"
            id="cancelButton"
        >
            取消编辑
        </button>

    </div>


    <!-- 订单记录 -->
    <div class="section">

        <h2>📋 单子记录</h2>

        <div class="search-area">

            <input
                type="text"
                id="search"
                placeholder="🔍 搜索客户或单子详情..."
                oninput="renderOrders()"
            >

            <select
                id="filterType"
                onchange="renderOrders()"
            >
                <option value="全部">全部类型</option>
                <option value="陪玩">陪玩</option>
                <option value="代打">代打</option>
                <option value="其他">其他</option>
            </select>

        </div>

        <div id="orderList"></div>

    </div>

</div>


<script>

/* =========================
   数据
========================= */

let orders = JSON.parse(
    localStorage.getItem("peiwanOrders")
) || [];

let editingId = null;


/* =========================
   默认日期
========================= */

document.getElementById("orderDate").value =
    getToday();


function getToday() {

    const now = new Date();

    const year = now.getFullYear();

    const month = String(
        now.getMonth() + 1
    ).padStart(2, "0");

    const day = String(
        now.getDate()
    ).padStart(2, "0");

    return `${year}-${month}-${day}`;
}


/* =========================
   保存数据
========================= */

function saveData() {

    localStorage.setItem(
        "peiwanOrders",
        JSON.stringify(orders)
    );

}


/* =========================
   新增 / 编辑
========================= */

function saveOrder() {

    const date =
        document.getElementById("orderDate").value;

    const customer =
        document.getElementById("customer").value.trim();

    const type =
        document.getElementById("orderType").value;

    const detail =
        document.getElementById("orderDetail").value.trim();

    const salary =
        parseFloat(
            document.getElementById("salary").value
        );

    const status =
        document.getElementById("status").value;


    if (!date) {

        alert("请选择日期！");
        return;

    }

    if (!customer) {

        alert("请输入客户名字！");
        return;

    }

    if (!detail) {

        alert("请输入单子详情！");
        return;

    }

    if (isNaN(salary) || salary < 0) {

        alert("请输入正确的工资！");
        return;

    }


    if (editingId !== null) {

        const index = orders.findIndex(
            order => order.id === editingId
        );

        if (index !== -1) {

            orders[index] = {

                id: editingId,

                date: date,

                customer: customer,

                type: type,

                detail: detail,

                salary: salary,

                status: status

            };

        }

        editingId = null;

    } else {

        orders.unshift({

            id: Date.now(),

            date: date,

            customer: customer,

            type: type,

            detail: detail,

            salary: salary,

            status: status

        });

    }


    saveData();

    clearForm();

    renderOrders();

    updateStats();

}


/* =========================
   清空表单
========================= */

function clearForm() {

    document.getElementById("customer").value = "";

    document.getElementById("orderType").value = "陪玩";

    document.getElementById("orderDetail").value = "";

    document.getElementById("salary").value = "";

    document.getElementById("status").value = "已结";

    document.getElementById("orderDate").value = getToday();

    document.getElementById("formTitle").innerText =
        "➕ 新增单子";

    document.getElementById("saveButton").innerText =
        "添加单子";

    document.getElementById("cancelButton").style.display =
        "none";

}


/* =========================
   编辑
========================= */

function editOrder(id) {

    const order = orders.find(
        order => order.id === id
    );

    if (!order) return;


    editingId = id;

    document.getElementById("orderDate").value =
        order.date;

    document.getElementById("customer").value =
        order.customer;

    document.getElementById("orderType").value =
        order.type;

    document.getElementById("orderDetail").value =
        order.detail;

    document.getElementById("salary").value =
        order.salary;

    document.getElementById("status").value =
        order.status;


    document.getElementById("formTitle").innerText =
        "✏️ 编辑单子";

    document.getElementById("saveButton").innerText =
        "保存修改";

    document.getElementById("cancelButton").style.display =
        "block";


    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

}


/* =========================
   取消编辑
========================= */

function cancelEdit() {

    editingId = null;

    clearForm();

}


/* =========================
   删除
========================= */

function deleteOrder(id) {

    const confirmDelete = confirm(
        "确定要删除这张单子吗？"
    );

    if (!confirmDelete) return;


    orders = orders.filter(
        order => order.id !== id
    );


    saveData();

    renderOrders();

    updateStats();

}


/* =========================
   显示订单
========================= */

function renderOrders() {

    const list =
        document.getElementById("orderList");

    const search =
        document.getElementById("search")
        .value
        .toLowerCase()
        .trim();

    const filter =
        document.getElementById("filterType").value;


    let filteredOrders = orders.filter(order => {

        const matchSearch =
            order.customer
                .toLowerCase()
                .includes(search)
            ||
            order.detail
                .toLowerCase()
                .includes(search);

        const matchType =
            filter === "全部"
            ||
            order.type === filter;

        return matchSearch && matchType;

    });


    if (filteredOrders.length === 0) {

        list.innerHTML = `
            <div class="empty">
                📭 暂时没有符合条件的单子
            </div>
        `;

        return;

    }


    list.innerHTML = filteredOrders.map(order => {

        const statusClass =
            order.status === "已结"
            ? "paid"
            : "unpaid";


        return `

        <div class="order">

            <div class="order-top">

                <div class="order-name">

                    ${escapeHTML(order.customer)}

                    <span class="type">
                        ${escapeHTML(order.type)}
                    </span>

                </div>

                <div class="order-money">
                    RM ${Number(order.salary).toFixed(2)}
                </div>

            </div>


            <div class="order-info">

                📅 ${order.date}

                <br>

                📝 ${escapeHTML(order.detail)}

                <br>

                <span class="status ${statusClass}">
                    ${order.status === "已结"
                        ? "✓ 已结"
                        : "⏳ 未结"}
                </span>

            </div>


            <div class="order-buttons">

                <button
                    class="btn btn-edit"
                    onclick="editOrder(${order.id})"
                >
                    ✏️ 编辑
                </button>

                <button
                    class="btn btn-delete"
                    onclick="deleteOrder(${order.id})"
                >
                    🗑️ 删除
                </button>

            </div>

        </div>

        `;

    }).join("");

}


/* =========================
   统计
========================= */

function updateStats() {

    const today = getToday();

    const now = new Date();

    const currentYear =
        now.getFullYear();

    const currentMonth =
        now.getMonth();


    const todayOrders =
        orders.filter(
            order => order.date === today
        );


    const monthOrders =
        orders.filter(order => {

            const date =
                new Date(order.date);

            return (
                date.getFullYear() === currentYear
                &&
                date.getMonth() === currentMonth
            );

        });


    const todayMoney =
        todayOrders.reduce(
            (total, order) =>
                total + Number(order.salary),
            0
        );


    const monthMoney =
        monthOrders.reduce(
            (total, order) =>
                total + Number(order.salary),
            0
        );


    document.getElementById("todayOrders")
        .innerText =
        todayOrders.length;


    document.getElementById("todayMoney")
        .innerText =
        todayMoney.toFixed(2);


    document.getElementById("monthOrders")
        .innerText =
        monthOrders.length;


    document.getElementById("monthMoney")
        .innerText =
        monthMoney.toFixed(2);

}


/* =========================
   防止特殊字符破坏页面
========================= */

function escapeHTML(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


/* =========================
   启动
========================= */

renderOrders();

updateStats();

</script>

</body>
</html>
