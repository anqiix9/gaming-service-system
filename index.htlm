<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>陪玩订单记录系统</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f7f3ff;
    color: #333;
    padding: 20px;
}

.container {
    max-width: 700px;
    margin: auto;
}

h1 {
    text-align: center;
    color: #7048b8;
    margin: 15px 0 25px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 18px;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
}

h2 {
    margin-bottom: 15px;
    color: #7048b8;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 6px;
    font-weight: bold;
}

input,
select,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-size: 15px;
    background: white;
}

textarea {
    min-height: 90px;
    resize: vertical;
}

button {
    width: 100%;
    padding: 13px;
    margin-top: 20px;
    border: none;
    border-radius: 12px;
    background: #7048b8;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    opacity: 0.9;
}

.order {
    border: 1px solid #eee;
    border-radius: 14px;
    padding: 15px;
    margin-top: 12px;
}

.order-title {
    font-size: 18px;
    font-weight: bold;
    color: #7048b8;
    margin-bottom: 10px;
}

.order p {
    margin: 7px 0;
    line-height: 1.5;
}

.delete-btn {
    background: #e85b6a;
    font-size: 14px;
    padding: 10px;
    margin-top: 10px;
}

.empty {
    text-align: center;
    color: #999;
    padding: 20px;
}
</style>
</head>

<body>

<div class="container">

<h1>🎮 陪玩订单记录</h1>

<div class="card">

<h2>➕ 新增订单</h2>

<label>📅 日期</label>
<input type="date" id="date">

<label>🎮 单子类型</label>
<select id="type">
    <option value="陪玩">陪玩</option>
    <option value="代打">代打</option>
    <option value="其他">其他</option>
</select>

<label>📋 单子详情</label>
<textarea id="details" placeholder="例如：王者荣耀 / 中路 / 2小时"></textarea>

<label>💰 工资 / 收入（RM）</label>
<input type="number" id="salary" placeholder="例如：20" step="0.01">

<button onclick="addOrder()">保存订单</button>

</div>

<div class="card">

<h2>📋 订单记录</h2>

<div id="orders"></div>

</div>

</div>

<script>

let orders = JSON.parse(localStorage.getItem("gamingOrders")) || [];

document.getElementById("date").valueAsDate = new Date();

function addOrder() {

    const date = document.getElementById("date").value;
    const type = document.getElementById("type").value;
    const details = document.getElementById("details").value;
    const salary = document.getElementById("salary").value;

    if (!date || !details || !salary) {
        alert("请把资料填写完整！");
        return;
    }

    const order = {
        id: Date.now(),
        date: date,
        type: type,
        details: details,
        salary: parseFloat(salary)
    };

    orders.push(order);

    localStorage.setItem(
        "gamingOrders",
        JSON.stringify(orders)
    );

    document.getElementById("details").value = "";
    document.getElementById("salary").value = "";

    displayOrders();
}

function deleteOrder(id) {

    if (!confirm("确定要删除这个订单吗？")) {
        return;
    }

    orders = orders.filter(order => order.id !== id);

    localStorage.setItem(
        "gamingOrders",
        JSON.stringify(orders)
    );

    displayOrders();
}

function displayOrders() {

    const container = document.getElementById("orders");

    if (orders.length === 0) {
        container.innerHTML =
            '<div class="empty">目前还没有订单 🥹</div>';
        return;
    }

    container.innerHTML = "";

    [...orders].reverse().forEach(order => {

        const div = document.createElement("div");

        div.className = "order";

        div.innerHTML = `
            <div class="order-title">
                🎮 ${order.type}
            </div>

            <p>📅 日期：${order.date}</p>

            <p>📋 详情：${escapeHtml(order.details)}</p>

            <p>💰 收入：RM ${order.salary.toFixed(2)}</p>

            <button
                class="delete-btn"
                onclick="deleteOrder(${order.id})">
                删除订单
            </button>
        `;

        container.appendChild(div);
    });
}

function escapeHtml(text) {

    const div = document.createElement("div");

    div.textContent = text;

    return div.innerHTML;
}

displayOrders();

</script>

</body>
</html>
